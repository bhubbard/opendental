{
  "name": "opendental-cf",
  "version": "24.3.0",
  "description": "Open Dental Practice Management on Cloudflare Serverless Edge Primitives",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "test": "vitest run",
    "test:rust": "cargo test --manifest-path rust/Cargo.toml",
    "test:all": "vitest run && cargo test --manifest-path rust/Cargo.toml",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "hono": "^4.6.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241022.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.3",
    "wrangler": "^3.84.0"
  }
}
